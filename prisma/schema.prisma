generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String          @id @default(cuid())
  name          String?
  email         String?         @unique
  emailVerified DateTime?
  image         String?
  role          String
  accounts      Account[]
  sessions      Session[]
  purchases     Purchase[]
  invoices      Invoice[]
  auditLogs     AuditLog[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model Software {
  id                String            @id @default(cuid())
  name              String
  slug              String            @unique
  description       String
  longDescription   String
  price             Int
  currency          String            @default("INR")
  billingType       String
  monthlyPrice      Int?
  category          String?
  platform          String?
  version           String?
  isPublished       Boolean           @default(true)
  downloadUrl       String?
  supportUrl        String?
  licenseEnabled    Boolean           @default(true)
  deliveryMethod    String
  features          SoftwareFeature[]
  purchases         Purchase[]
  invoices          Invoice[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model SoftwareFeature {
  id          String   @id @default(cuid())
  softwareId  String
  label       String
  software    Software @relation(fields: [softwareId], references: [id], onDelete: Cascade)
}

model Purchase {
  id                   String             @id @default(cuid())
  userId               String
  softwareId           String
  stripeSessionId      String?            @unique
  stripePaymentIntent  String?
  amount               Int
  currency             String
  status               String
  licenseKey           String?
  licenseStatus        String
  licenseRevokedAt     DateTime?
  licenseRevokedReason String?
  subtotalAmount       Int?
  taxAmount            Int                @default(0)
  invoiceNumber        String?            @unique
  paidAt               DateTime?
  receiptEmail         String?
  receiptStatus        String
  receiptPreparedAt    DateTime?
  receiptSentAt        DateTime?
  lastReceiptError     String?
  invoiceStatus        String
  invoiceIssuedAt      DateTime?
  invoiceVoidedAt      DateTime?
  invoiceVoidReason    String?
  downloadCount        Int                @default(0)
  lastDownloadedAt     DateTime?
  grantedAt            DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  software             Software           @relation(fields: [softwareId], references: [id], onDelete: Cascade)
  downloadGrants       DownloadGrant[]
  invoice              Invoice?
  @@index([userId, status])
}

model DownloadGrant {
  id          String      @id @default(cuid())
  purchaseId  String
  tokenHash   String      
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime    @default(now())
  status      String      @default("ACTIVE")
  }

model Invoice {
  id              String        @id @default(cuid())
  purchaseId      String        @unique
  userId          String
  softwareId      String
  invoiceNumber   String        @unique
  currency        String
  subtotalAmount  Int
  taxAmount       Int           @default(0)
  totalAmount     Int
  status          String
  issuedAt        DateTime      @default(now())
  voidedAt        DateTime?
  voidReason      String?
  receiptSentAt   DateTime?
  notes           String?
  purchase        Purchase      @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  software        Software      @relation(fields: [softwareId], references: [id], onDelete: Cascade)

  @@index([userId, issuedAt])
}

model EmailDispatch {
  id          String   @id @default(cuid())
  toEmail     String
  subject     String
  template    String
  provider    String?
  status      String   @default("PENDING")
  lastError   String?
  sentAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  purchaseId  String?
  invoiceId   String?
  userId      String?
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  action      String
  entityType  String
  entityId    String?
  meta        String?
  createdAt   DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

