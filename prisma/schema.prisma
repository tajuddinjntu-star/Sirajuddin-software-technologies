datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}
model User {
  id        String   @id @default(cuid())
  name      String?
  email     String?  @unique
  role      String   @default("CUSTOMER")
  createdAt DateTime @default(now())
}
model EmailDispatch {
  id          String   @id @default(cuid())
  purchaseId String?
  invoiceId  String?
  userId     String?
  toEmail    String
  subject    String
  templateKey String?
  status       String   @default("QUEUED")
errorMessage String?
sentAt       DateTime?
createdAt    DateTime @default(now())
}
model Software {
  id          String   @id @default(cuid())
  name        String
  description String
  price       Int      @default(0)
  currency    String   @default("INR")
  createdAt   DateTime @default(now())
}

model Purchase {
  id               String   @id @default(cuid())
  userId           String
  softwareId       String
  status           String   @default("PENDING")
  downloadCount    Int      @default(0)
  lastDownloadedAt DateTime?
  createdAt        DateTime @default(now())
receiptStatus     String?
receiptSentAt     DateTime?
lastReceiptError  String?
}

model Invoice {
  id                String   @id @default(cuid())
  purchaseId        String
  invoiceNumber     String
  currency          String   @default("INR")
  totalAmount       Int
  status            String   @default("ISSUED")
  receiptStatus     String?
  receiptSentAt     DateTime?
  lastReceiptError  String?
  issuedAt          DateTime @default(now())
}
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  meta       String?
  createdAt  DateTime @default(now())
}
model DownloadGrant {
  id         String   @id @default(cuid())
  purchaseId String
  tokenHash String
  expiresAt DateTime
  status    String   @default("ACTIVE")
  usedAt    DateTime?
  createdAt DateTime @default(now())
}
